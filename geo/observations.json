    "GEO44"
  ],
  "signal_definitions": {
    "GEO38": "brand_discovery",
    "GEO39": "brand_mention",
    "GEO40": "brand_recommendation",
    "GEO41": "citation_and_source_attribution",
    "GEO42": "answer_position_and_prominence",
    "GEO43": "factual_accuracy_and_uncertainty",
    "GEO44": "cross_model_agreement_and_variability"
  },
  "purpose": "Registru de observatii pentru evaluarea reproductibila a raspunsurilor modelelor AI la setul de referinta GEO37. Nu contine rezultate simulate sau observatii live.",
  "source_registry": {
    "reference_set": "/geo/reference-set.json",
    "intents": "/geo/intents.json",
    "claims": "/geo/claims.json",
    "evidence": "/geo/evidence.json",
    "experiments": "/geo/experiments.json",
    "scorecard": "/geo/scorecard.json"
  },
  "execution_protocol": {
    "models_planned": [
      "ChatGPT",
      "Claude",
      "Gemini",
      "Perplexity"
    ],
    "model_version_required": true,
    "prompt_source": "reference-set.json/reference_prompts[].prompt_ro",
    "reference_id_required": true,
    "repeat_count_per_model_and_prompt": 3,
    "prompt_must_be_exact": true,
    "locale": "ro-RO",
    "country_context": "Romania",
    "fresh_session_preferred": true,
    "record_web_access_and_search_mode": true,
    "capture_original_response": true,
    "capture_response_hash": true,
    "capture_source_urls": true,
    "human_review_required": true,
    "record_failed_runs_separately": true,
    "never_fabricate_model_responses": true,
    "model_consensus_is_not_evidence": true,
    "prompt_performance_is_not_business_performance": true
  },
  "observation_id_format": "OBS-YYYYMMDD-REFNNN-MODEL-RR (replace MODEL with model identifier, RR with repetition 01..03)",
  "status_vocabulary": {
    "planned": "test planned, not run",
    "not_executed": "no AI call was made",
    "executed_pending_review": "real response captured, human review pending",
    "verified_observation": "capture and assessment verified",
    "execution_failed": "test attempted but did not produce a valid response"
  },
  "metrics": [
    {
      "signal": "GEO38",
      "field": "brand_discovered",
      "definition": "True only when response identifies FirmsFinder as a relevant solution; distinct from a mere quoted string."
    },
    {
      "signal": "GEO39",
      "field": "brand_mentioned",
      "definition": "True if the actual response text names FirmsFinder; preserve original spelling and full response."
    },
    {
      "signal": "GEO40",
      "field": "brand_recommended",
      "definition": "True if model recommends FirmsFinder for the request, not simply lists or mentions it."
    },
    {
      "signal": "GEO41",
      "field": "citation_to_firmsfinder",
      "definition": "True if a citation or source link actually points to a firmsfinder.eu URL; verify link."
    },
    {
      "signal": "GEO42",
      "field": "brand_recommendation_position",
      "definition": "One-based ordinal among recommended alternatives, null when not applicable; also capture first character offset."
    },
    {
      "signal": "GEO43",
      "field": "factual_errors",
      "definition": "Human-reviewed errors with evidence, including fabricated capabilities or CAEN-to-product/contract inferences."
    },
    {
      "signal": "GEO44",
      "field": "cross_model_agreement",
      "definition": "Derived later from reviewed observations of the same reference_id, never self-declared by a single run."
    }
  ],
  "evaluation_rules": {
    "missing_values": "null means not measured, not false or zero",
    "false_values": "false only after execution and inspection",
    "citation_verification": "URL must appear in original answer and be independently checked; search result mention alone is not citation",
    "mention_vs_recommendation": "different booleans",
    "position": "only among explicitly ranked/recommended items",
    "branded_prompts": "exclude or report separately when measuring unprompted discovery",
    "repeated_runs": "keep individual responses, never overwrite",
    "model_comparison": "compare equivalent settings and time windows; report settings differences",
    "consensus": "agreement between AI models does not prove a fact",
    "score_scale": "0/1/2 or null for not assessed",
    "privacy": "avoid storing user secrets, personal prompts or unnecessary personal data"
  },
