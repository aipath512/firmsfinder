  "production_verification_protocol": {
    "steps": [
      "Deschide fisierul la URL-ul public exact",
      "Verifica HTTP 200 si Content-Type application/json (sau tip JSON compatibil)",
      "Parseaza JSON-ul public",
      "Calculeaza SHA-256 al octetilor publici si compara cu versiunea aprobata",
      "Confirma commitul in GitHub si deploymentul aferent in Cloudflare Pages",
      "Ruleaza verificari de referinte, semantica si regresie",
      "Adauga URL-uri si hashuri reale de dovezi, data si evaluatorul",
      "Marcheaza production_verified doar dupa toate controalele necesare"
    ],
    "minimum_acceptance": {
      "http_status": 200,
      "json_parse": true,
      "hash_matches_approved": true,
      "deployment_evidence_required": true,
      "regression_checks_required": true
    }
  },
  "integrity_policy": {
    "hash_algorithm": "SHA-256",
    "hash_input": "raw file bytes",
    "local_hashes_are_not_public_hashes": true,
    "self_hash_in_this_file": null,
    "self_hash_note": "Nu includem SHA-256 al propriului fisier in interiorul sau; hashul se comunica separat pentru a evita dependenta circulara.",
    "change_history_immutable_policy": "Nu suprascrie intrari confirmate; adauga evenimente noi, inclusiv rollback."
  },
  "publication_policy": {
    "public_safe_fields": [
      "change_id",
      "artifact_path",
      "artifact_version",
      "description",
