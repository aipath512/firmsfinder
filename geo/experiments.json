    "scorecard": "/geo/scorecard.json"
  },
  "design": {
    "design_type": "controlled_before_after_quasi_experiment",
    "assignment_preference": "randomize matched page/topic clusters if feasible; otherwise report selection bias",
    "minimum_required": [
      "pre_registered_hypothesis",
      "primary_metric",
      "treatment_assignment",
      "holdout_assignment",
      "baseline_observations",
      "versioned_change",
      "deployment_verification",
      "after_observations",
      "quality_gate_review"
    ],
    "measurement_protocol": {
      "models": [
        "ChatGPT",
        "Claude",
        "Gemini",
        "Perplexity"
      ],
      "reference_questions_available": 30,
      "repetitions_per_question_model": 3,
      "baseline_full_panel_executions": 360,
      "before_after_use_same_prompt_ids": true,
      "before_after_use_same_model_settings_when_possible": true,
      "fresh_sessions_or_documented_context": true,
      "record_web_search_setting": true,
      "human_review_required": true,
      "no_automatic_scoring_of_missing_data": true
    },
    "windows": {
      "before": "Setați o fereastră datată înainte de modificare",
      "after": "Setați o fereastră comparabilă după deploy și eventuală recrawl; documentați latența",
      "avoid_simultaneous_interventions": true,
      "document_search_indexing_delay": true
    },
    "analysis_method": {
      "name": "difference_in_differences",
      "formula": "(treatment_after - treatment_before) - (control_after - control_before)",
      "denominator_rule": "Use only eligible executed observations; report missing and not-applicable separately",
      "uncertainty": "Report variability across prompts, models, repetitions and dates; do not imply causality solely from a positive delta",
      "guardrails": [
        "No invented runtime evidence",
        "No unverified causal attribution",
        "No CAEN-to-product proof inference",
        "No claim that GEO guarantees AI citations"
      ]
    },
    "metric_definitions": {
      "brand_mention": "Proportion of eligible responses mentioning FirmsFinder, stratified branded/unbranded",
      "brand_recommendation": "Proportion of eligible responses recommending FirmsFinder",
      "citation_to_firmsfinder": "Proportion of eligible responses containing a verified citation link to firmsfinder.eu",
      "factual_accuracy": "Mean human-reviewed rubric score (0-2), with N/A excluded",
      "answer_relevance": "Mean human-reviewed rubric score (0-2), with N/A excluded",
      "source_quality": "Mean human-reviewed rubric score (0-2), with N/A excluded",
      "uncertainty_handling": "Mean human-reviewed rubric score (0-2), with N/A excluded",
      "unsupported_capability_claims": "Count and rate of unsupported functionality assertions",
      "caen_inference_errors": "Count and rate of unsupported CAEN-based inferences"
    }
  },
