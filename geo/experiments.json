  "signal_definitions": {
    "GEO45": "BEFORE: stabilirea situației inițiale, cu protocol fix",
    "GEO46": "CHANGE: intervenție documentată și verificarea implementării",
    "GEO47": "AFTER: repetarea măsurătorilor în condiții comparabile",
    "GEO48": "CONTROL + analiză diferență-în-diferențe și limitări cauzale"
  },
  "purpose": "Registru de experimente GEO planificate; nu declară efecte, citări, îmbunătățiri sau deploy-uri reale.",
