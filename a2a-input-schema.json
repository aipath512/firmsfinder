{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "cui"
      ],
      "properties": {
        "operation": {
          "const": "company.get"
        },
        "cui": {
          "type": "string",
          "pattern": "^[0-9]{2,10}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "ids"
      ],
      "properties": {
        "operation": {
          "const": "company.compare"
        },
        "ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{2,10}$"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "const": "company.search"
        },
        "q": {
          "type": "string",
          "maxLength": 120
        },
        "caen": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "revision": {
          "const": 2
        },
        "judet": {
          "type": "string",
          "maxLength": 60
        },
        "localitate": {
          "type": "string",
          "maxLength": 60
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      },
      "anyOf": [
        {
          "required": [
            "q"
          ],
          "properties": {
            "q": {
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "caen"
          ],
          "properties": {
            "caen": {
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "judet"
          ],
          "properties": {
            "judet": {
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "localitate"
          ],
          "properties": {
            "localitate": {
              "minLength": 1
            }
          }
        }
      ]
    }
  ]
}
